# ===========================================
# SNISHOP Digital Content Production System
# Environment Configuration
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=content_production
DB_USER=snishop
DB_PASSWORD=your_database_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=snishop:content:

# AWS S3 / Object Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=snishop-content
AWS_S3_ENDPOINT=

# AI Services
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_IMAGE_MODEL=dall-e-3
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key

# SNISHOP API Integration
SNISHOP_API_URL=https://api.snishop.com
SNISHOP_API_KEY=your_snishop_api_key
SNISHOP_ERP_URL=https://erp.snishop.com
SNISHOP_APP_URL=https://app.snishop.com

# Social Media APIs
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
SHOPEE_APP_ID=
SHOPEE_PARTNER_KEY=
TOKOPEDIAN_API_KEY=

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@snishop.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=SNISHOP Content System
SMTP_FROM_EMAIL=noreply@snishop.com

# Quality Settings
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080
IMAGE_QUALITY=85
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300
SCREENSHOT_TIMEOUT=30000
SCREENSHOT_VIEWPORT_WIDTH=1920
SCREENSHOT_VIEWPORT_HEIGHT=1080

# BullMQ / Job Queue
BULLMQ_CONCURRENCY=5
BULLMQ_MAX_RETRIES=3
BULLMQ_RETRY_DELAY=5000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Lynk.id Integration
LYNK_ID_API_URL=https://lynk.id
LYNK_ID_API_KEY=your_lynk_id_api_key

# Usahakan Digital Integration
USAHAKAN_API_URL=https://usahakan.digital
USAHAKAN_API_KEY=your_usahakan_api_key
